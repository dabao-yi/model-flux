{
  "name": "@model-flux/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --env-file=../.env dist/index.js",
    "dev": "node --env-file=../.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "start:src": "node --env-file=../.env --import tsx src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.11",
    "undici": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
